# Na Vercel: Project > Settings > Environment Variables. NUNCA suba este arquivo preenchido.
ASAAS_API_KEY=cole_aqui_a_chave_da_api
# sandbox para testar; producao quando for vender de verdade
ASAAS_ENV=sandbox
# Token que você inventa e cadastra no webhook do Asaas (mesmo valor nos dois lugares)
ASAAS_WEBHOOK_TOKEN=defina_um_token_longo_e_aleatorio
# Senha para baixar a lista de pedidos em /api/pedidos
ADMIN_TOKEN=defina_outra_senha_longa
SITE_URL=https://www.gasomax.com.br
# Opcional: 1 para redirecionar a /obrigado.html após pagar (exige o site cadastrado no Asaas)
ASAAS_REDIRECT=0
# UPSTASH_REDIS_REST_URL e UPSTASH_REDIS_REST_TOKEN (ou KV_REST_API_*) a Vercel cria sozinha ao conectar o Upstash
